# Flask
FLASK_ENV=development
SECRET_KEY=change-me
APP_PORT=8000
APP_ENV=prod

# PostgreSQL
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=energy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://energy:change-me@energy_db:5432/energy

# Optional: home coordinates for heating degree days (Open-Meteo archive, no key needed).
# Leave empty to turn the weather comparison off. Two decimals (~1 km) are plenty.
WEATHER_LAT=
WEATHER_LON=
